<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.travelsky.base</groupId>
        <artifactId>travelsky_dev_parent3</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <groupId>com.swcares</groupId>
    <artifactId>sample</artifactId>
    <version>2.0-SNAPSHOT</version>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <travelsky.dev.version>3.0.0-SNAPSHOT</travelsky.dev.version>
        <!-- 由 mybatis / jpa profile 覆盖为对应的 ORM 示例代码目录 -->
        <orm.source.dir>src/main/mybatis/java</orm.source.dir>
    </properties>

    <dependencies>
        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓最简启动依赖(必选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- web：统一响应包装、CRUD 基类、国际化、慢请求/防重切面；其下已传递 core / security -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_web</artifactId>
        </dependency>
        <!-- core：应用上下文持有、异步调度、消息门面、Feign 全局负载均衡（web 已传递，此处显式声明以示用法） -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_core</artifactId>
        </dependency>
        <!-- common：ResultVO / DevQueryVO / Page / UserContextHolder / BusinessException -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_common</artifactId>
        </dependency>
        <!-- utils：JsonUtils / GlobalIdGenerator / StringUtils / DateUtils / BeanUtils -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_utils</artifactId>
        </dependency>
        <!-- repository：数据变更日志(DataChangeLog)与数据迁移(@DataMigration)的公共模型 -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_repository</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑最简启动依赖(必选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓添加监控依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- monitor：放行 /actuator/** 白名单，配合 MonitorBootLoader 打印启动信息 -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_monitor</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑添加监控依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓添加认证依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- security：JWT + 表单登录 + 配置加密(ENC()) -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_security</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑添加认证依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓添加线程池管理依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- threadpool：按 thread-pool.* 自动注册命名线程池，支持动态调参与监控端点 -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_threadpool</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑添加线程池管理依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓添加缓存依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- cache：@EnableCaching + 自定义 KeyGenerator；具体 CacheManager 由 classpath 上的实现决定 -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_cache</artifactId>
        </dependency>
        <!-- cache 模块把 Caffeine 声明为 optional，此处显式引入 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑添加缓存依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓添加动态数据源依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- dynamic_datasource：@DynamicDatasource 注解切库，需 dynamic.datasource.enabled=true -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_dynamic_datasource</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑添加动态数据源依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓添加去中心化服务发现依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- decentralization_discovery：无注册中心的集群广播/选主，需 decentralization.discovery.enable=true -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_decentralization_discovery</artifactId>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑添加去中心化服务发现依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓AI 预留模块(暂无内容)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- travelsky_dev_ai 目前为空壳占位模块，仅保留坐标以便后续扩展，无自动装配内容 -->
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑AI 预留模块(暂无内容)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓单元测试依赖(可选)↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <!-- test：Testcontainers 容器基类 + @DataSet 数据编排（示例见 src/test/java） -->
        <dependency>
            <groupId>com.travelsky.base</groupId>
            <artifactId>travelsky_dev_test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑单元测试依赖(可选)↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.34</version> <!-- 建议使用最新稳定版 -->
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ORM 相关的示例代码按 profile 分目录，保证 mybatis / jpa 两种构建都能通过：
                 src/main/java       —— 与 ORM 无关的公共示例
                 src/main/mybatis/java —— MyBatis-Plus 版 Entity/Dao/Service/装配
                 src/main/jpa/java     —— JPA 版 Entity/Dao/Service/装配（与上者同名同类，二选一参与编译） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-orm-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${orm.source.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓使用Mybatis作为ORM框架↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <profile>
            <id>mybatis</id>
            <activation>
                <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓建议使用Mybatis↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <orm.source.dir>src/main/mybatis/java</orm.source.dir>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.travelsky.base</groupId>
                    <artifactId>travelsky_dev_mybatis_repository</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.travelsky.base</groupId>
                    <artifactId>travelsky_dev_data_migration</artifactId>
                    <exclusions>
                        <!-- data_migration 同时依赖两套 ORM，与 mybatis 场景冲突，需排除 JPA 实现 -->
                        <exclusion>
                            <groupId>com.travelsky.base</groupId>
                            <artifactId>travelsky_dev_jpa_repository</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                    <version>8.0.33</version>
                </dependency>
            </dependencies>
        </profile>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑使用Mybatis作为ORM框架↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->
        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓使用jpa作为ORM框架↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <profile>
            <id>jpa</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <orm.source.dir>src/main/jpa/java</orm.source.dir>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.travelsky.base</groupId>
                    <artifactId>travelsky_dev_jpa_repository</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.travelsky.base</groupId>
                    <artifactId>travelsky_dev_data_migration</artifactId>
                    <exclusions>
                        <!-- 与 jpa 场景冲突，需排除 MyBatis 实现 -->
                        <exclusion>
                            <groupId>com.travelsky.base</groupId>
                            <artifactId>travelsky_dev_mybatis_repository</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                    <version>8.0.33</version>
                </dependency>
            </dependencies>
        </profile>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑使用jpa作为ORM框架↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->
        <!--↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓使用连接池↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓-->
        <profile>
            <id>dynamicDatasource</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.zaxxer</groupId>
                    <artifactId>HikariCP</artifactId>
                    <version>7.0.2</version>
                </dependency>
            </dependencies>
        </profile>
        <!--↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑使用连接池↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑↑-->
    </profiles>

</project>
