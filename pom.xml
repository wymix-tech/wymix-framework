<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.8</version>
    </parent>

    <groupId>com.travelsky.base</groupId>
    <artifactId>travelsky_dev_parent3</artifactId>
    <version>${revision}</version>

    <packaging>pom</packaging>
    <description>Travelsky Dev Framework - Based On APD</description>

    <modules>
        <module>travelsky_dev_core</module>
        <module>travelsky_dev_common</module>
        <module>travelsky_dev_repository</module>
        <module>travelsky_dev_jpa_repository</module>
        <module>travelsky_dev_mybatis_repository</module>
        <module>travelsky_dev_utils</module>
        <module>travelsky_dev_web</module>
        <module>travelsky_dev_test</module>
        <module>travelsky_dev_cache</module>
        <module>travelsky_dev_security</module>
        <module>travelsky_dev_monitor</module>
        <module>travelsky_dev_threadpool</module>
        <module>travelsky_dev_data_migration</module>
        <module>travelsky_dev_decentralization_discovery</module>
        <module>travelsky_dev_dynamic_datasource</module>
        <module>travelsky_dev_ai</module>
    </modules>

    <properties>
        <revision>3.0.0-SNAPSHOT</revision>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipTests>false</skipTests>
        <jjwt.version>0.13.0</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_utils</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_repository</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_jpa_repository</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_mybatis_repository</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_dynamic_datasource</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_test</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_monitor</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_threadpool</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_data_migration</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_decentralization_discovery</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.travelsky.base</groupId>
                <artifactId>travelsky_dev_ai</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>2.14.5</version>
            </dependency>
            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast-spring</artifactId>
                <version>5.2.5</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-joda</artifactId>
                <version>2.13.5</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-core</artifactId>
                <version>13.1</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-slf4j</artifactId>
                <version>13.1</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-jackson</artifactId>
                <version>13.1</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-httpclient</artifactId>
                <version>13.1</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-openfeign</artifactId>
                <exclusions>
                    <exclusion>
                        <groupId>io.github.openfeign</groupId>
                        <artifactId>feign-core</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.github.openfeign</groupId>
                        <artifactId>feign-slf4j</artifactId>
                    </exclusion>
                </exclusions>
                <version>3.1.3</version>
            </dependency>
            <!--loadbalancer包必须引入，因为openfeign底层集成了ribbon  -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-loadbalancer</artifactId>
                <version>3.1.3</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>3.5.15</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jmdns</groupId>
                <artifactId>jmdns</artifactId>
                <version>3.5.12</version>
            </dependency>
            <dependency>
                <groupId>org.hibernate.validator</groupId>
                <artifactId>hibernate-validator</artifactId>
                <version>8.0.3.Final</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>32.1.3-jre</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>0.10.2</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>2.8.15</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.3.0</version>
                <inherited>true</inherited>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <configuration>
                            <!-- 避免IDE将 .flattened-pom.xml 自动识别为功能模块 -->
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>resolveCiFriendliesOnly</flattenMode>
                            <pomElements>
                                <parent>expand</parent>
                                <distributionManagement>remove</distributionManagement>
                                <repositories>remove</repositories>
                            </pomElements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>