<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
    </parent>

    <groupId>org.wymix.framework</groupId>
    <artifactId>dev_parent</artifactId>
    <version>${revision}</version>

    <packaging>pom</packaging>
    <description>Wymix Dev Framework</description>

    <modules>
        <module>core_api</module>
        <module>core</module>
        <module>common</module>
        <module>repository</module>
        <module>jpa_repository</module>
        <module>mybatis_repository</module>
        <module>utils</module>
        <module>web</module>
        <module>test</module>
        <module>cache</module>
        <module>security</module>
        <module>monitor</module>
        <module>threadpool</module>
        <module>data_migration</module>
        <module>decentralization_discovery</module>
        <module>dynamic_datasource</module>
        <module>ai</module>
    </modules>

    <properties>
        <revision>3.0.0-SNAPSHOT</revision>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipTests>false</skipTests>
        <test.jvm.args></test.jvm.args>
        <jjwt.version>0.13.0</jjwt.version>
        <!-- Spring Cloud 版本线，需与 spring-boot-starter-parent 的 Boot 版本匹配（Boot 3.5.x -> 2025.0.x） -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- 需与 spring-cloud-dependencies 中 spring-cloud-openfeign-dependencies 的 feign.version 保持一致 -->
        <feign.version>13.6.1</feign.version>
        <!-- 原先依赖 spring-cloud-context 的传递引入，升级 Spring Cloud 后该路径已不存在，改为显式声明 -->
        <commons-io.version>2.17.0</commons-io.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>org.wymix.framework</groupId><artifactId>core_api</artifactId><version>${revision}</version></dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>utils</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>repository</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>jpa_repository</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>mybatis_repository</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>dynamic_datasource</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>test</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>monitor</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>threadpool</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>data_migration</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>decentralization_discovery</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.wymix.framework</groupId>
                <artifactId>ai</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>2.14.5</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-joda</artifactId>
                <version>2.13.5</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-core</artifactId>
                <version>${feign.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-slf4j</artifactId>
                <version>${feign.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-jackson</artifactId>
                <version>${feign.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-httpclient</artifactId>
                <version>${feign.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <!--
              Spring Cloud 版本由官方 BOM 统一管理，避免 openfeign / commons / loadbalancer 各自指定版本时错配。
              BOM 必须与 spring-boot-starter-parent 的 Boot 版本对应（见 https://spring.io/projects/spring-cloud 的版本矩阵）：
              Boot 3.5.x -> Spring Cloud 2025.0.x（2025.0.3 对应 Boot 3.5.15）。
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              各 spring-cloud starter 的版本一律由上面的 BOM 提供，此处不要再声明无版本的同 artifact 条目：
              dependencyManagement 中后置条目会覆盖 BOM import 的结果，导致版本反而缺失。
              需要剔除传递依赖（如 feign-core / feign-slf4j）时，在各模块自己的 <dependencies> 里写 exclusions。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>3.5.15</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.hibernate.validator</groupId>
                <artifactId>hibernate-validator</artifactId>
                <version>8.0.3.Final</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>32.1.3-jre</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>0.10.2</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>2.8.15</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions><execution><id>test-agent</id><phase>process-test-classes</phase><goals><goal>copy</goal></goals>
                    <configuration><artifactItems><artifactItem>
                        <groupId>net.bytebuddy</groupId><artifactId>byte-buddy-agent</artifactId><version>${byte-buddy.version}</version>
                        <outputDirectory>${project.build.directory}/test-agent</outputDirectory><destFileName>byte-buddy-agent.jar</destFileName>
                    </artifactItem></artifactItems></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><argLine>-javaagent:${project.build.directory}/test-agent/byte-buddy-agent.jar ${test.jvm.args}</argLine></configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.3.0</version>
                <inherited>true</inherited>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <configuration>
                            <!-- 避免IDE将 .flattened-pom.xml 自动识别为功能模块 -->
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>resolveCiFriendliesOnly</flattenMode>
                            <pomElements>
                                <parent>expand</parent>
                                <distributionManagement>remove</distributionManagement>
                                <repositories>remove</repositories>
                            </pomElements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>